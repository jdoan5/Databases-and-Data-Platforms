# Copy to tagline/.env (gitignored) and fill in. The pipeline reads this file;
# variables already set in the environment win over it.

# Google Cloud project that holds tagline_raw, tagline_staging and tagline_marts
# (all in the US multi-region). Required.
TAGLINE_GCP_PROJECT=your-project-id

# The site's own GA4 export dataset, analytics_<property_id>, created when GA4 is
# linked to BigQuery. Leave empty until it exists: the build then uses only the
# public GA4 sample.
TAGLINE_GA4_DATASET=

# Project that holds TAGLINE_GA4_DATASET, if it is not TAGLINE_GCP_PROJECT.
# TAGLINE_GA4_PROJECT=

# Cost guard applied to every query job, in bytes. A job that would bill more fails
# before it runs. Default 10 GB; the largest job (stg_events) bills about 3.4 GiB, and a
# whole build with its checks about 8.5 GiB.
# TAGLINE_MAX_BYTES_BILLED=10000000000
