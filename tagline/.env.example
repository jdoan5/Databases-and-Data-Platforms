# Copy to tagline/.env (gitignored) and fill in. The pipeline reads this file;
# variables already set in the environment win over it.

# Google Cloud project that holds tagline_raw, tagline_staging and tagline_marts
# (all in the US multi-region). Required.
TAGLINE_GCP_PROJECT=your-project-id

# The site's own GA4 export dataset, analytics_<property_id>, created when GA4 is
# linked to BigQuery. Leave empty until it exists: the build then uses only the
# public GA4 sample.
TAGLINE_GA4_DATASET=

# Project that holds TAGLINE_GA4_DATASET, if it is not TAGLINE_GCP_PROJECT.
# TAGLINE_GA4_PROJECT=

# Cost guard applied to every query job, in bytes. A job that would bill more fails
# before it runs. Default 10 GB; the largest job (stg_events) bills about 3.4 GiB, and a
# whole build with its checks about 8.5 GiB.
# TAGLINE_MAX_BYTES_BILLED=10000000000

# --- Stage 3: the Spark attribution job on Dataproc Serverless (docs/orchestration.md) ---
# The Airflow DAG reads all three when it is parsed and will not import without them, even
# for a Stage 2 only run. The placeholders below parse, so the DAG imports; a real batch needs
# real values.

# Region the Dataproc Serverless batches run in (keep the bucket in the same region).
TAGLINE_GCP_REGION=us-central1

# Bucket (name, or gs://name) for the Spark job's code (code/attribution/<version>/) and the BigQuery
# connector's temporary Parquet files (.spark-bigquery-*/), which it deletes after each completed load;
# a batch stopped mid-write leaves its files behind (docs/orchestration.md, Limitations). Runtime 3.0
# writes no Dataproc staging files here.
TAGLINE_SPARK_BUCKET=your-project-id-spark

# Service account the batches run as. It needs Dataproc Worker, BigQuery Job User and BigQuery
# Read Session User on the project, object admin on the bucket, read on tagline_staging and write
# on tagline_marts. Whoever submits a batch needs Service Account User on it.
TAGLINE_SPARK_SERVICE_ACCOUNT=tagline-spark@your-project-id.iam.gserviceaccount.com
