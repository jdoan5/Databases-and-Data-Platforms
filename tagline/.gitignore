# Local configuration: holds the Google Cloud project id. Copy .env.example to .env.
.env

# The pipeline's and the Spark job's virtual environments, and Python caches
pipeline/.venv/
spark/.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Cost logs written by `make build COSTS_JSON=...`
pipeline/runs/

